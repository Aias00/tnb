{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@tnb/plugin-sdk": [
        "./src/plugin-sdk/index.ts"
      ],
      "@tnb/plugin-sdk/testing": [
        "./src/plugin-sdk/testing.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples"
  ]
}
